NODE_ENV=production
HOST=127.0.0.1
PORT=3080

# Keep this file private. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Use private persistent directories; do not put uploads under the website's public root.
DATA_DIR=/var/lib/scardrone-files
DATABASE_PATH=/var/lib/scardrone-files/scar-files.sqlite
SESSION_DATABASE_PATH=/var/lib/scardrone-files/sessions.sqlite
STORAGE_DIR=/var/lib/scardrone-files/uploads

# File, request-batch, and total stored data limits
MAX_UPLOAD_BYTES=1073741824
MAX_UPLOAD_BATCH_BYTES=2147483648
MAX_UPLOAD_FILES=10
MAX_STORAGE_BYTES=107374182400
SESSION_MAX_AGE_MS=28800000
